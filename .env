# Copy this file to .env and fill in your values

# ---- Sentry ----
# Your Sentry DSN (get from Sentry project settings)
SENTRY_DSN=https://0cb829fffd09451b6db32c6fbc154e48@o4510778974273536.ingest.us.sentry.io/4510778977353728

# Environment name (development, staging, production)
SENTRY_ENVIRONMENT=development

# ---- Django (required when using opentelemetry-instrument) ----
DJANGO_SETTINGS_MODULE=sandbox_project.settings

# ---- PagerDuty ----
# Integration Key (routing key) from PagerDuty service → Integrations → Events API V2
PAGERDUTY_ROUTING_KEY=e317de417bd04108d01ee25b4e214323

# ---- Honeycomb (OpenTelemetry) ----
# Service name that appears in Honeycomb
OTEL_SERVICE_NAME=sentry-honeycomb-sandbox

# Export protocol
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Honeycomb OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# Your Honeycomb API key (get from Account > Team Settings > API Keys)
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-honeycomb-api-key
